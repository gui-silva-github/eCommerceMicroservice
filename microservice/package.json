{
  "name": "microservice",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:azure": "ng serve --configuration=azure --host 0.0.0.0 --port 4200",
    "start:entra": "ng serve --configuration=entra --host 0.0.0.0 --port 4200",
    "build": "ng build",
    "build:azure": "ng build --configuration=azure-prod",
    "build:entra": "ng build --configuration=entra-prod",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/animations": "^21.1.0",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@azure/msal-angular": "^5.3.1",
    "@azure/msal-browser": "^5.25.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.1.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
